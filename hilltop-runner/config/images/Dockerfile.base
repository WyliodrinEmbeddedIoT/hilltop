# ==========================================
# STAGE 1: Compile OpenOCD Nightly
# ==========================================
FROM debian:trixie-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git libtool pkg-config autoconf automake \
    libusb-1.0-0-dev libhidapi-dev libjaylink-dev libftdi1-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# 1. Do a normal clone first
RUN git clone https://github.com/openocd-org/openocd.git .
# 2. Explicitly pull in the submodules (jimtcl and libjaylink)
RUN git submodule update --init --recursive

RUN ./bootstrap && \
    ./configure \
      --prefix=/opt/openocd \
      --enable-internal-jimtcl \
      --enable-ftdi \
      --enable-jlink \
      --enable-stlink \
      --enable-cmsis-dap && \
    make -j$(nproc) && \
    make install

# ==========================================
# STAGE 2: The HIL Toolchain Base
# ==========================================
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libusb-1.0-0-dev libudev-dev pkg-config build-essential \
    libhidapi-hidraw0 libftdi1-2 libjaylink0 \
    python3 git pipx curl ca-certificates udev \
    socat netcat-openbsd unzip make stlink-tools \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/openocd /opt/openocd
ENV PATH="/opt/openocd/bin:${PATH}"
RUN mkdir -p /opt/openocd/share/openocd/scripts/board/jtag && \
    { \
      echo "source [find interface/jlink.cfg]"; \
      echo "transport select swd"; \
      echo "source [find target/nordic/nrf52.cfg]"; \
    } > /opt/openocd/share/openocd/scripts/board/jtag/nrf52840dk.cfg && \
    { \
      echo "source [find interface/jlink.cfg]"; \
      echo "transport select swd"; \
      echo "source [find target/nordic/nrf52.cfg]"; \
    } > /opt/openocd/share/openocd/scripts/board/jtag/nrf52dk.cfg

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

RUN cargo install --locked probe-rs-tools

ENV PIPX_HOME=/opt/pipx
ENV PIPX_BIN_DIR=/usr/local/bin
RUN pipx install tockloader

WORKDIR /workspace
CMD ["/bin/bash"]
